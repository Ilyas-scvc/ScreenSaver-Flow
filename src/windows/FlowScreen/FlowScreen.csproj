<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FlowScreen</AssemblyName>
    <RootNamespace>FlowScreen</RootNamespace>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Required by the LibraryImport source generator, which emits pinned
         pointer marshalling for the P/Invokes in Interop/NativeMethods.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FlowScreen.ico</ApplicationIcon>
    <UseWindowsForms>false</UseWindowsForms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- InvariantGlobalization must stay off: WPF's text layout calls
         XmlLanguage.GetSpecificCulture(), which throws without ICU data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Keep the published folder to just the executable: the WebView2 package
         otherwise drops ~750 KB of XML documentation next to it. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <Product>FlowScreen</Product>
    <Company>FlowScreen</Company>
    <Description>FlowScreen - procedural GPU screensaver for Windows</Description>
    <Copyright>MIT licensed</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>

  <!--
    The built renderer bundle is embedded rather than copied next to the exe.
    That is what lets the published .scr be a single self-contained file, which
    matters because Windows only lists screensavers that live directly in
    System32 - a folder of loose assets could not go there.

    Vite is configured to emit a flat, unhashed dist/, so one line covers it.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\renderer\**\*.*"
                      Exclude="Assets\renderer\**\.gitkeep"
                      LogicalName="renderer/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\FlowScreen.ico" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <Target Name="WarnIfRendererMissing" BeforeTargets="Build">
    <Warning Condition="!Exists('$(MSBuildProjectDirectory)\Assets\renderer\index.html')"
             Text="Renderer bundle not found in Assets\renderer. Run scripts\build.ps1 (or 'npm run build' in src\renderer and copy dist\* here) or the app will only work against the Vite dev server." />
  </Target>

</Project>
