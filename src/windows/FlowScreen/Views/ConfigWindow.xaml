<Window x:Class="FlowScreen.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowScreen Settings"
        Width="940"
        Height="650"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#FF0A060E"
        Foreground="#FFF2E8F2"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#FF150E1B" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#FF201628" />
        <SolidColorBrush x:Key="Line" Color="#33FF9DD2" />
        <SolidColorBrush x:Key="Accent" Color="#FFFF4FA3" />
        <SolidColorBrush x:Key="Muted" Color="#99F2E8F2" />
        <SolidColorBrush x:Key="Text" Color="#FFF2E8F2" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Picker" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="30" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="{StaticResource Surface}"
                                                BorderBrush="{StaticResource Line}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="26" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" />
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="#CCFF9DD2"
                                                      StrokeThickness="1.4" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,3,0,0">
                                    <ScrollViewer MaxHeight="280">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#40FF9DD2" CornerRadius="4" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="#FFB4207A"
                                BorderBrush="#FFFF4FA3"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFD62A92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="404" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= header ================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="26,20,26,16" Background="#FF0F0A15">
            <StackPanel>
                <TextBlock Text="FlowScreen" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                <TextBlock x:Name="SubtitleText"
                           Text="Procedural GPU screensaver"
                           FontSize="12"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <!-- ================= settings ================= -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="26,0,20,0">
            <StackPanel x:Name="SettingsPanel">

                <TextBlock Text="STYLE" Style="{StaticResource SectionTitle}" Margin="0,14,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Effect" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="EffectPicker" Grid.Column="1" Style="{StaticResource Picker}" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Particle density" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="DensityPicker" Grid.Column="1" Style="{StaticResource Picker}" />
                </Grid>

                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Speed" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.1" Maximum="3" />
                    <TextBlock x:Name="SpeedValue" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Fiber length" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="LengthSlider" Grid.Column="1" Minimum="0.2" Maximum="3" />
                    <TextBlock x:Name="LengthValue" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Glow" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="GlowSlider" Grid.Column="1" Minimum="0" Maximum="2" />
                    <TextBlock x:Name="GlowValue" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Trail" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="TrailSlider" Grid.Column="1" Minimum="0" Maximum="0.95" />
                    <TextBlock x:Name="TrailValue" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                </Grid>

                <TextBlock Text="PALETTE" Style="{StaticResource SectionTitle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Preset" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PalettePicker" Grid.Column="1" Style="{StaticResource Picker}" />
                </Grid>

                <Border Margin="0,12,0,0" Height="26" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource Line}">
                    <UniformGrid x:Name="SwatchStrip" Rows="1" Columns="6" />
                </Border>

                <StackPanel x:Name="CustomPaletteFields" Margin="0,12,0,0" />

                <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionTitle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Frame rate" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="FpsPicker" Grid.Column="1" Style="{StaticResource Picker}" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Render scale" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ScalePicker" Grid.Column="1" Style="{StaticResource Picker}" />
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Adaptive quality" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="AdaptivePicker" Grid.Column="1" Style="{StaticResource Picker}" />
                </Grid>

                <CheckBox x:Name="VsyncCheck" Content="Wait for vertical sync" Margin="0,12,0,0" />

                <TextBlock Text="DISPLAYS AND SEED" Style="{StaticResource SectionTitle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Multiple monitors" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="MonitorPicker" Grid.Column="1" Style="{StaticResource Picker}" />
                </Grid>

                <TextBlock x:Name="MonitorHint"
                           Margin="130,6,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}" />

                <CheckBox x:Name="RandomSeedCheck" Content="Pick a new random world on every launch" Margin="0,14,0,0" />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Seed" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SeedBox" Grid.Column="1" Style="{StaticResource Field}" />
                    <Button x:Name="RandomizeButton" Grid.Column="2" Style="{StaticResource Action}"
                            Content="Randomize" MinWidth="0" Padding="12,5" />
                </Grid>

                <CheckBox x:Name="OverlayCheck" Content="Show the performance overlay" Margin="0,14,0,24" />
            </StackPanel>
        </ScrollViewer>

        <!-- ================= live preview ================= -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="6,14,26,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="LIVE PREVIEW" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />

            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True"
                    BorderThickness="1" BorderBrush="{StaticResource Line}" Background="Black">
                <Grid x:Name="PreviewRoot" Background="Black">
                    <TextBlock x:Name="PreviewStatus"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               LineHeight="20"
                               Foreground="{StaticResource Muted}"
                               FontSize="12"
                               Text="Starting the preview..." />
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="0,10,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Muted}"
                       Text="The preview runs the same renderer as the screensaver at a reduced resolution. Changing the seed restarts it." />
        </Grid>

        <!-- ================= actions ================= -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="26,14" Background="#FF0F0A15">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource Muted}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DefaultsButton" Style="{StaticResource Action}" Content="Reset defaults" MinWidth="120" />
                    <Button x:Name="CancelButton" Style="{StaticResource Action}" Content="Cancel" IsCancel="True" />
                    <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="Save" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
