<Window x:Class="FlowScreen.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowScreen Preview"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Black"
        Width="152"
        Height="112">

    <Grid x:Name="HostRoot" Background="Black">
        <TextBlock x:Name="Placeholder"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   Opacity="0.45"
                   Foreground="#FF9DD2"
                   Text="FlowScreen" />
    </Grid>
</Window>
